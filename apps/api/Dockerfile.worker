FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libxml2-dev \
    libxslt1-dev \
    tesseract-ocr \
    tesseract-ocr-spa \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY packages/tax-engine /packages/tax-engine
COPY packages/cfdi-parser /packages/cfdi-parser
COPY packages/bank-parser /packages/bank-parser

RUN pip install --no-cache-dir \
    /packages/tax-engine \
    /packages/cfdi-parser \
    /packages/bank-parser

COPY apps/api/ .

CMD ["rq", "worker", "--url", "$REDIS_URL", "default"]
